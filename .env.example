# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/test_booking?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random secret in production)
JWT_SECRET=super-secret-jwt-key-change-this-in-production-min-32-chars

# Admin One-Time Setup Secret Key (Required for registering initial admin user)
ADMIN_SETUP_SECRET=admin-setup-secret-key-12345

# Frontend CORS Origin (For production deployment)
FRONTEND_URL=http://localhost:5173

# Frontend Environment Variable (Vite API Base URL - blank for single Vercel deployment, or full backend URL if deployed separately)
VITE_API_URL=
